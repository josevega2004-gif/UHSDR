digi_bench-break-rx
*.wav
*.pgm
*.o
# the on-air fixture is the one recording the bench keeps: everything else it writes stays untracked
!fixtures/*.wav
# the WebSDR client capture/decode_oracle.js loads: pa3fwm's, all rights reserved, and allowed only
# to be served unmodified by the receiver, so a local copy must never end up in a commit
capture/websdr-sound.js
convolution_probe
# the radio's filter path table, cut out of drivers/audio/audio_filter.c by the Makefile for the probe
filter_paths.gen.c
# the geometry the convolution harness was last built with, so a measurement cannot be taken from an object compiled with different -D flags
.convolution_defs
